# Environment Variables
# Copy this file to .env.local and fill in the values

# No wallet setup needed: visitors get an auto-generated guest identity.
# (VITE_WALLETCONNECT_PROJECT_ID is accepted for backwards compatibility but unused.)

# Required: XMTP environment (dev | production)
VITE_XMTP_ENV=

# Required: Application base URL (must be a valid URL once normalized).
# Use a full URL: https://your-domain.com or http://localhost:3000
# Bare hostnames are OK: example.com becomes https://example.com; localhost:3000 becomes http://localhost:3000
VITE_APP_URL=

# Optional: Comma-separated GunDB relay peer URLs.
# Presence and group coordination need at least one reachable relay, otherwise
# every visitor only sees themselves and chat never starts. Run the bundled
# relay locally with `npm run relay` (default below), and set this to your
# hosted relay URL (https) in production.
VITE_GUN_RELAY_PEERS=http://localhost:8765/gun

# Optional: Sliding window duration in minutes (default: 15)
VITE_SLIDING_WINDOW_MINUTES=

# Optional: set to "true" to emit [xmtp-mls-diagnostics-v1] JSON from production
# builds as well. Dev builds always emit diagnostics; leave this unset normally.
VITE_XMTP_MLS_DIAGNOSTICS=

# Optional: Comma-separated Ethereum addresses the room leader adds to every
# group it creates, on top of the online visitors. Use it to seat an
# xmtp-bridge (rate-limited relay to an AI agent): the address of its
# [shoutbox] key_file. Each address must have an XMTP inbox on VITE_XMTP_ENV.
VITE_SHOUTBOX_BRIDGE_ADDRESSES=
